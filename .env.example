APP_NAME="Untitled Unionisation Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unionisation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Address lookup: geoapify | fake (fake needs no key; for local dev and tests)
ADDRESS_LOOKUP_DRIVER=fake
GEOAPIFY_API_KEY=

# Email replies to union mail: union mail is sent with Reply-To replies+<token>@domain,
# and union-mail:fetch-replies reads them over IMAP. Leave the address blank to send
# replies straight to each union's inbox instead. Drivers: imap | fake
INBOUND_MAIL_ADDRESS=
INBOUND_MAIL_DRIVER=imap
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_ENCRYPTION=ssl
INBOUND_IMAP_USERNAME=
INBOUND_IMAP_PASSWORD=
INBOUND_IMAP_FOLDER=INBOX

# Images uploaded into rich text. Dev uses the local public disk (run php artisan storage:link).
# Production: UPLOADS_DISK=r2, a bucket served from a Cloudflare-cached custom domain (R2_URL)
# with the CSAM Scanning Tool enabled, and UPLOADS_WARM_CACHE=true. See docs/architecture/uploads.md.
UPLOADS_DISK=public
UPLOADS_WARM_CACHE=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=
